public class Restaurant{
 public String brand;
 public String location;
 
 
 public UberEatsUser [] user = new UberEatsUser [3];
 public boolean orderReady;
 
 public Restaurant(String brand, String location){
  this.location = location;
  this.brand = brand;
 }
 
public void takeOrder( UberEatsUser User ){
   if (User.address == null){
    System.out.println("Location : Unknown. Please update your location information!");
    return;
   }
   for (int i = 0; i < user.length; i++){
    if (user[i] == User){
     System.out.println("You already have a pending order!");
     return;
    }
   }

   boolean noEmptySpace = true;
   for (int i = 0; i < user.length; i++){
     if (user[i]==null){
     user[i] = User;
     noEmptySpace =false;
     System.out.println("Your order has been added!");
     break;
     }
   }
   if (noEmptySpace == true) System.out.println("We are really busy right now. Please order after some time. Thank you!");
 }
 
 public void takeOrder( UberEatsUser User, String location){
  User.address = location;
  takeOrder( User );
 }
 
public void completeOrders(){
   boolean orders = false;
   for (int i = 0; i < user.length; i++){
     if (user[i]!=null){
      if (orders == false) System.out.println("Showing "+this.brand+"'s orders:");
      System.out.println("Order by "+user[i].name+ " at "+user[i].address+" completed");
      user[i] = null;
      orders = true;
     }
   }
   if (orders == false) System.out.println("No pending orders at the moment.");
 }
 
}