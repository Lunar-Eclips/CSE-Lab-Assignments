public class Product{
 public String name;
 public int qty;
 static Product [] arr = new Product [3];
 Static int count;
 
 public class Product(String name,int qty){
   if(count >= 3){
   this.name = name;
   this.qty = qty;
   for(int i = 0;i < 3;i++){
     if (arr[i]==null){
       arr[i]= this;
       count++;
       break;
     }
   }
   System.out.println("Stored: "+name);
   } else {
   System.out.println("Storage is full! Cannot add "+name);
   }
 }
 
 public void displayProducts(){
   for(int i = 0;i < 3;i++){
     if(arr[i]!=null){
       System.out.println(arr[i].name+"- Qty: "+arr[i].qty);
     }
   }
 }
 
}