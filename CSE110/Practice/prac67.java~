public class prac67{
  public static void main (String [] args){
    int [] arr = {7,3,5,80,24,17,45,36,47}
    for (int i = 0; i < arr.length() - 1; i++){
      for (int j = i + 1; j < arr.length() - 1; j++){
        if (arr[i] > arr[j]){
        int temp = 0;
        temp = arr[i];
        arr[i] = arr [j];
        arr[j] = temp;
        }
      }
    }
    System.out.print(arr.toString());

  }
}