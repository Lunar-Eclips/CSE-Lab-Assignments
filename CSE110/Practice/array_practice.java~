import java.util.Scanner;
import javautil.Arrays;
public class array_practice
{
public static void main(String[]args)
 {
  Scanner sc=new Scanner(System.in);
  int [] arr1=new int[10];
  int [] arr2=new int[5]; //odd
  int [] arr3=new int[5]; //even
  int [] arr4=new int[10]; //for printing
  int odd_count=0;
  int even_count=0;
  for (int i=0;i<10;i++)
   {
    int n=sc.nextInt();
    arr1[i]=n;
    if (n%2==0)
     {
      arr3[even_count]=n;
      even_count++;
     }
    else
     {
      arr4[even_count]=n;
      odd_count++;
     }
   }
  arr4=arr2+arr3;
  System.out.print(Arrays.toString(arr4))
 }
}